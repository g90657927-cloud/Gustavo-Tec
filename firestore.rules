rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Online real-time messages - anyone can read, authenticated users can write
    match /online_messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.email == "sougustavo000@gmail.com");
    }

    // Article comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.email == "sougustavo000@gmail.com");
    }

    // User profiles & role administration
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // User reading preferences (dark reading mode, opacity, 3D spatial, contrast)
    match /reading_preferences/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // AI Chat / Gemini assistant history per user
    match /ai_chat_history/{chatId} {
      allow read: if true;
      allow write: if true;
    }

    // Role audit logs
    match /role_logs/{logId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && request.auth.token.email == "sougustavo000@gmail.com";
    }

    // System Global Configuration & Maintenance Mode
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.email == "sougustavo000@gmail.com";
    }
  }
}
